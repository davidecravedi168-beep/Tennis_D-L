name: Tennis Zero Cost Quant

on:
  workflow_dispatch:
  schedule:
    - cron: "13 */2 * * *"

permissions:
  contents: write

concurrency:
  group: tennis-zero-cost-quant
  cancel-in-progress: false

jobs:
  quant:
    runs-on: ubuntu-latest
    timeout-minutes: 12

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Run Zero Cost Quant
        env:
          ODDS_API_KEY: ${{ secrets.ODDS_API_KEY }}
        run: node quant-engine.mjs

      - name: Commit state safely
        shell: bash
        run: |
          set -e

          if [ -z "$(git status --porcelain -- data/quant-board.json)" ]; then
            echo "No quant changes"
            exit 0
          fi

          cp data/quant-board.json /tmp/quant-board.json

          git config user.name "tennis-zero-cost-bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          for attempt in 1 2 3; do
            echo "Push attempt $attempt"

            git fetch origin main
            git reset --hard origin/main

            mkdir -p data
            cp /tmp/quant-board.json data/quant-board.json
            git add data/quant-board.json

            if git diff --cached --quiet; then
              echo "Remote already contains this quant state"
              exit 0
            fi

            git commit -m "quant: autonomous zero-cost update"

            if git push origin HEAD:main; then
              echo "Quant state saved successfully"
              exit 0
            fi

            echo "Remote moved again; retrying..."
            sleep 3
          done

          echo "Unable to save quant state after 3 attempts"
          exit 1
